# Variables d'environnement attendues par le projet.
# Copier vers .env et compléter avec les vraies valeurs. Ne jamais committer .env.
# Chaque variable ajoutée au code doit apparaître ici, sans valeur, avec un commentaire.
# Rappel : les variables préfixées NEXT_PUBLIC_, VITE_, EXPO_PUBLIC_… sont visibles dans le navigateur.

# Backend — optionnel en local : sans cette variable, l'API utilise la base de docker-compose.yml.
# Obligatoire en production, au format postgresql+asyncpg://utilisateur:mot-de-passe@hote:port/base
DATABASE_URL=

# Backend — adresse du site vue par le navigateur, sans « / » final (ADR-0006). Optionnel en local :
# http://localhost:3000 par défaut. Obligatoire en production : elle autorise les écritures, et une adresse
# en https:// active le cookie Secure.
SITE_ORIGINE=

# Site, côté serveur uniquement — adresse de l'API pour le rendu des pages protégées et, en local, pour le
# proxy /api du serveur de développement. Optionnel en local : http://127.0.0.1:8000 par défaut.
API_URL_INTERNE=

# Backend — clé Fernet qui chiffre les secrets de double authentification (spec 015, ADR-0008). Optionnelle
# en local : une clé est alors créée dans backend/.cle-chiffrement-locale.key. Obligatoire en production.
# Générer avec : uv run --directory backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La perdre oblige à réinitialiser toutes les doubles authentifications : la sauvegarder hors du serveur.
CLE_CHIFFREMENT=

# Backend — inscription des élèves (spec 017). Vide : ouvertes en local, fermées dès que le site est en https://.
# true pour les ouvrir (préproduction, données de test) ; en production, pas avant le récépissé de l'IPDCP (RULES).
INSCRIPTIONS_OUVERTES=
# Backend — nombre d'inscriptions par heure depuis une même adresse réseau. Optionnel : 20 par défaut.
INSCRIPTIONS_MAX_ADRESSE=
# Backend — version de la charte acceptée à l'inscription, à changer avec le texte de /charte. Optionnel.
VERSION_CHARTE=

# Backend — environnement de déploiement : develop en local, preprod ou prod sur le VPS. L'API s'en sert pour
# autoriser les comptes de test uniquement en préproduction (voir deploy/env.example).
ENVIRONNEMENT=

# Backend — envoi des e-mails (specs 015 et 030) : invitations, avis aux encadreurs, codes des visiteurs.
# Sans SMTP_HOTE, hors production, le lien d'invitation et le code sont renvoyés par l'API (lien_de_test,
# code_de_test) ; en production, l'inscription des visiteurs est alors refusée. Fournisseur proposé : Brevo
# (deploy/README.md, étape 9). SMTP_SECURITE : starttls (port 587), ssl (port 465) ou aucune.
SMTP_HOTE=
SMTP_PORT=
SMTP_SECURITE=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Adresse d'expédition, par exemple « Clubs Santé <no-reply@exemple.tg> »
SMTP_EXPEDITEUR=

# Les variables de la preprod et de la prod sont décrites dans deploy/env.example et deploy/proxy/env.example.

# Dossier des fichiers envoyés (photos des articles, spec 024). Vide : backend/var/fichiers en local.
# En déploiement, deploy/compose.yaml le fixe au volume Docker /donnees/fichiers.
DOSSIER_FICHIERS=
