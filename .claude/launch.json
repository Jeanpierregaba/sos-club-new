{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000",
        "--strictPort"
      ],
      "port": 3000,
      "env": {
        "API_URL_INTERNE": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "fastapi",
        "dev",
        "app/main.py",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
