# Modèle du fichier /opt/sosclub/proxy/.env sur le VPS. Ne jamais le committer une fois rempli.

# Reçoit les alertes de Let's Encrypt sur les certificats.
ACME_EMAIL=

# Sans https:// : par exemple exemple.tg et preprod.exemple.tg. Les deux doivent déjà pointer vers le VPS.
DOMAINE_PROD=
DOMAINE_PREPROD=

# Domaines redirigés en 301 vers DOMAINE_PROD, séparés par une virgule, par exemple www.clubsante.org, clubsante.tech.
# Chacun doit déjà pointer vers le VPS, sinon Caddy ne peut pas obtenir son certificat.
DOMAINES_REDIRIGES=
