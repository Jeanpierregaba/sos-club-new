# Modèle du fichier /opt/sosclub/proxy/.env sur le VPS. Ne jamais le committer une fois rempli.

# Reçoit les alertes de Let's Encrypt sur les certificats.
ACME_EMAIL=

# Sans https:// : par exemple exemple.tg et preprod.exemple.tg. Les deux doivent déjà pointer vers le VPS.
DOMAINE_PROD=
DOMAINE_PREPROD=

# La preprod est protégée par un mot de passe : elle n'est pas destinée au public.
PREPROD_UTILISATEUR=
# Générer avec : docker run --rm caddy:2.11.7-alpine caddy hash-password
# Le garder entre apostrophes : l'empreinte contient des « $ ».
PREPROD_MOT_DE_PASSE_HASH=''
