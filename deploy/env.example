# Modèle du fichier /opt/sosclub/<environnement>/.env sur le VPS. Ne jamais le committer une fois rempli.
# Le créer avec : install -m 600 /dev/null .env

# preprod ou prod : le même nom que le dossier.
ENVIRONNEMENT=

# Adresse publique du site, sans « / » final, par exemple https://preprod.exemple.tg
SITE_ORIGINE=

# Générer avec : openssl rand -hex 32. Uniquement des caractères hexadécimaux : il entre dans une URL.
# Une valeur différente pour chaque environnement.
POSTGRES_PASSWORD=

# Clé qui chiffre les secrets de double authentification de l'espace admin (ADR-0008). Une par environnement.
# Générer avec : docker run --rm python:3-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# La sauvegarder hors du VPS : la perdre oblige à réinitialiser toutes les doubles authentifications.
CLE_CHIFFREMENT=

# Inscription des élèves (spec 017) : true en préproduction, avec des données de test seulement. En production,
# laisser vide (fermées) tant que le récépissé de l'IPDCP n'est pas reçu (docs/RULES.md).
INSCRIPTIONS_OUVERTES=
# Facultatif : inscriptions par heure depuis une même adresse réseau, 20 par défaut. À augmenter pour une
# séance d'inscription encadrée dans une salle informatique.
# INSCRIPTIONS_MAX_ADRESSE=20

# Envoi des e-mails d'invitation. SMTP_SECURITE : starttls (port 587) ou ssl (port 465).
SMTP_HOTE=
SMTP_PORT=587
SMTP_SECURITE=starttls
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Par exemple « Clubs Santé <no-reply@exemple.tg> »
SMTP_EXPEDITEUR=

# Facultatif : registre des images, ghcr.io/jeanpierregaba/sos-club-new par défaut.
# IMAGE_PREFIX=

# Facultatif : nombre de processus de l'API, 2 par défaut. Chacun peut utiliser environ 256 Mio pendant les connexions.
# API_PROCESSUS=2
