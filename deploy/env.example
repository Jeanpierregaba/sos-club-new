# Modèle du fichier /opt/sosclub/<environnement>/.env sur le VPS. Ne jamais le committer une fois rempli.
# Le créer avec : install -m 600 /dev/null .env

# preprod ou prod : le même nom que le dossier.
ENVIRONNEMENT=

# Adresse publique du site, sans « / » final, par exemple https://preprod.exemple.tg
SITE_ORIGINE=

# Générer avec : openssl rand -hex 32. Uniquement des caractères hexadécimaux : il entre dans une URL.
# Une valeur différente pour chaque environnement.
POSTGRES_PASSWORD=

# Facultatif : registre des images, ghcr.io/jeanpierregaba/sos-club-new par défaut.
# IMAGE_PREFIX=

# Facultatif : nombre de processus de l'API, 2 par défaut. Chacun peut utiliser environ 256 Mio pendant les connexions.
# API_PROCESSUS=2
